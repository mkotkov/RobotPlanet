<Window x:Class="RobotPlanet.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:RobotPlanet.Wpf.Properties"
        Title="{x:Static p:Resources.Window_Title}" Height="780" Width="1040"
        Background="#0B0B0C" Foreground="#F2F2F2"
        FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="14">

    <Window.Resources>
        <!-- Värvid -->
        <SolidColorBrush x:Key="Bg" Color="#0B0B0C"/>
        <SolidColorBrush x:Key="Card" Color="#1C1D1F"/>
        <SolidColorBrush x:Key="Field" Color="#2A2B2E"/>
        <SolidColorBrush x:Key="Row" Color="#26272A"/>
        <SolidColorBrush x:Key="RowHover" Color="#303135"/>
        <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="Ink" Color="#0B0B0C"/>
        <SolidColorBrush x:Key="Lime" Color="#E8FF55"/>
        <SolidColorBrush x:Key="White" Color="#F5F5F5"/>

        <!-- Väike hall silt (pärib esiplaani värvi, seega töötab ka laimikaardil) -->
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <!-- GroupBox: suur ümar kaart -->
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="30"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Top" ContentSource="Header"
                                                  TextElement.FontSize="12" Opacity="0.6"
                                                  Margin="0,0,0,12"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button: tume pill, hoveril valge -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="22" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource White}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Peamine nupp: laim -->
        <Style x:Key="LimeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Lime}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- TextBox: tume ümar väli, fookuses laimi serv -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Lime}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="16" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Lime}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ProgressBar: paks ümar riba -->
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource Lime}"/>
            <Setter Property="Background" Value="#40808080"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="5"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox: read ümarate pillidena, valitud rida laimiga -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="22" Background="{StaticResource Row}"
                                Padding="16,12" Margin="0,0,0,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Lime}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Logi read: lihtsad, ilma valikuta -->
        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="0,5">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="14" Background="Transparent"
                                Padding="{TemplateBinding Padding}" Margin="4,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Lime}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource Field}" CornerRadius="16" MinHeight="34">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource Lime}"
                                                  StrokeThickness="2" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="14,5,34,5" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource Card}" CornerRadius="20"
                                        Margin="0,6,0,0" Padding="0,6">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Pealkiri -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static p:Resources.Window_Title}"
                   FontSize="30" FontWeight="SemiBold" Margin="4,0,0,18"/>

        <!-- VASAK: nimekiri + lisamine -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
            <GroupBox DockPanel.Dock="Bottom" Header="{x:Static p:Resources.Group_Add}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Type}"
                               Margin="2,2,16,2" VerticalAlignment="Center"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="TypeBox" Margin="2,3"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Id}"
                               Margin="2,2,16,2" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="IdBox" Margin="2,3"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Name}"
                               Margin="2,2,16,2" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="NameBox" Margin="2,3"/>
                    <TextBlock Grid.Row="3" Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Battery}"
                               Margin="2,2,16,2" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="BatteryBox" Text="100" Margin="2,3"/>
                    <TextBlock Grid.Row="4" Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Integrity}"
                               Margin="2,2,16,2" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="IntegrityBox" Text="100" Margin="2,3"/>
                    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource LimeButton}" Content="{x:Static p:Resources.Btn_Add}"
                                Click="Add_Click" Padding="20,8" Margin="2,2,8,2"/>
                        <Button Content="{x:Static p:Resources.Btn_Remove}" Click="Remove_Click"
                                Padding="20,8" Margin="2"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="{x:Static p:Resources.Group_List}">
                <ListBox x:Name="RobotList" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ProgressBar Value="{Binding Battery, Mode=OneWay}" Maximum="100" Height="8"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <ProgressBar Value="{Binding Integrity, Mode=OneWay}" Maximum="100" Height="8"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             Opacity="0.5" Margin="0,5,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </DockPanel>

        <!-- PAREM: üksikasjad (laimikaart) + tegevused -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
            <GroupBox Header="{x:Static p:Resources.Group_Details}"
                      Background="{StaticResource Lime}" Foreground="{StaticResource Ink}"
                      DataContext="{Binding SelectedItem, ElementName=RobotList}">
                <StackPanel>
                    <TextBlock Text="{Binding Mode=OneWay}" FontSize="22" FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <UniformGrid Columns="2" Margin="0,18,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock FontSize="40" FontWeight="SemiBold">
                                <Run Text="{Binding Battery, Mode=OneWay}"/><Run Text="%" FontSize="22"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Battery}"
                                       Margin="0,0,0,8"/>
                            <ProgressBar Value="{Binding Battery, Mode=OneWay}" Maximum="100"
                                         Foreground="{StaticResource Ink}" Background="#26000000"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock FontSize="40" FontWeight="SemiBold">
                                <Run Text="{Binding Integrity, Mode=OneWay}"/><Run Text="%" FontSize="22"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Integrity}"
                                       Margin="0,0,0,8"/>
                            <ProgressBar Value="{Binding Integrity, Mode=OneWay}" Maximum="100"
                                         Foreground="{StaticResource Ink}" Background="#26000000"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static p:Resources.Group_Actions}" Margin="0,12,0,0">
                <StackPanel>
                    <UniformGrid Columns="2">
                        <Button Content="{x:Static p:Resources.Btn_Work}" Click="Work_Click"
                                Padding="4,10" Margin="2,2,4,2"/>
                        <Button Style="{StaticResource LimeButton}" Content="{x:Static p:Resources.Btn_Crazy}"
                                Click="Crazy_Click" Padding="4,10" Margin="4,2,2,2"/>
                    </UniformGrid>

                    <TextBlock Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_ChargeAmount}"
                               Margin="4,16,2,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static p:Resources.Btn_Charge}"
                                Click="Charge_Click" Padding="20,8" Margin="8,2,2,2"/>
                        <TextBox x:Name="ChargeBox" Text="30" Margin="2" FontSize="18"/>
                    </DockPanel>

                    <Button Content="{x:Static p:Resources.Btn_Scan}" Click="Scan_Click"
                            Margin="2,14,2,2" Padding="4,10"/>

                    <TextBlock Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_RepairTarget}"
                               Margin="4,16,2,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static p:Resources.Btn_Repair}"
                                Click="Repair_Click" Padding="20,8" Margin="8,2,2,2"/>
                        <ComboBox x:Name="TargetBox" Margin="2,3"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- ALL: logi -->
        <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="{x:Static p:Resources.Group_Log}">
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0"
                        Content="{x:Static p:Resources.Btn_ClearLog}" Click="ClearLog_Click" Padding="18,7"/>
                <ListBox x:Name="LogList" ItemContainerStyle="{StaticResource PlainItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>