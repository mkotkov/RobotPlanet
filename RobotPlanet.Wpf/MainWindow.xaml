<Window x:Class="RobotPlanet.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:RobotPlanet.Wpf.Properties"
        xmlns:vm="clr-namespace:RobotPlanet.Wpf.ViewModels"
        Title="{x:Static p:Resources.Window_Title}"
        Width="1040" Height="780" MinWidth="380" MinHeight="420"
        MaxWidth="{Binding Path=Width, Source={x:Static SystemParameters.WorkArea}}"
        MaxHeight="{Binding Path=Height, Source={x:Static SystemParameters.WorkArea}}"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged"
        Background="#0B0B0C" Foreground="#F2F2F2"
        FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="14">

    <!-- The View gets everything from the ViewModel. No logic lives in MainWindow.xaml.cs. -->
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Colours -->
        <SolidColorBrush x:Key="Bg" Color="#0B0B0C"/>
        <SolidColorBrush x:Key="Card" Color="#1C1D1F"/>
        <SolidColorBrush x:Key="Field" Color="#2A2B2E"/>
        <SolidColorBrush x:Key="Row" Color="#26272A"/>
        <SolidColorBrush x:Key="RowHover" Color="#303135"/>
        <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="Ink" Color="#0B0B0C"/>
        <SolidColorBrush x:Key="Lime" Color="#E8FF55"/>
        <SolidColorBrush x:Key="White" Color="#F5F5F5"/>

        <!-- Thin scrollbar -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="4" Background="#55FFFFFF" Margin="2,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small grey caption -->
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <!-- GroupBox: big rounded card -->
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="28"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Top" ContentSource="Header"
                                                  TextElement.FontSize="12" Opacity="0.6"
                                                  Margin="0,0,0,12"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button: dark pill, white on hover, dimmed when the command cannot execute -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="22" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource White}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Main button: lime -->
        <Style x:Key="LimeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Lime}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Lime}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="16" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Lime}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CheckBox: rounded square with a lime tick -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="22" Height="22" CornerRadius="8"
                                    Background="{StaticResource Field}">
                                <Path x:Name="Tick" Data="M 5 11 L 9 15 L 17 6"
                                      Stroke="{StaticResource Lime}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ProgressBar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource Lime}"/>
            <Setter Property="Background" Value="#40808080"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="5"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox: rows as rounded pills, selected row in lime -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="22" Background="{StaticResource Row}"
                                Padding="16,12" Margin="0,0,0,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Lime}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Repository chips (wrap on narrow screens) -->
        <Style x:Key="ChipList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChipItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="18" Background="{StaticResource Row}"
                                Padding="14,8" Margin="0,0,8,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Lime}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Log rows: plain, not selectable -->
        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="0,5">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="14" Background="Transparent"
                                Padding="{TemplateBinding Padding}" Margin="4,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Lime}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource Field}" CornerRadius="16" MinHeight="34">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource Lime}"
                                                  StrokeThickness="2" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="14,5,34,5" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource Card}" CornerRadius="20"
                                        Margin="0,6,0,0" Padding="0,6">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Vol.3 ===== -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Slider: thin rounded track, lime fill, round white thumb -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="8" CornerRadius="4" Background="{StaticResource Lime}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmpty" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="28" Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{StaticResource White}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid MinHeight="28" Background="Transparent">
                            <Border Height="8" CornerRadius="4" Background="#40808080" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderEmpty}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status chip of a report row: lime = success, red = failed, grey = cancelled -->
        <Style x:Key="StatusChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Background" Value="#8C9189"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Success">
                    <Setter Property="Background" Value="{StaticResource Lime}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Background" Value="#FF7A7A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One row of a report: name, status, duration, calculation title and the result or error text -->
        <DataTemplate x:Key="OutcomeRowTemplate">
            <Border CornerRadius="18" Background="{StaticResource Row}" Padding="14,10" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Opacity="0.7"
                                   VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Left" Style="{StaticResource StatusChip}" Margin="10,0,0,0">
                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Cap}" Text="{Binding CalculationTitle}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- The whole page scrolls vertically, so nothing is cut off on small screens -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static p:Resources.Window_Title}"
                       FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,0,0,16"/>

            <!-- ===================== LEFT: repositories, search, robots, add ===================== -->
            <StackPanel x:Name="LeftPanel" Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">

                <!-- Repositories: one per robot type -->
                <GroupBox Header="{x:Static p:Resources.Group_Repos}">
                    <ListBox Style="{StaticResource ChipList}"
                             ItemContainerStyle="{StaticResource ChipItem}"
                             ItemsSource="{Binding Repositories}"
                             SelectedItem="{Binding SelectedRepository}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Count}" Margin="10,0,0,0" Opacity="0.6"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>

                <!-- LINQ: search (Where) and sort (OrderBy / OrderByDescending) -->
                <GroupBox Header="{x:Static p:Resources.Group_Search}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Search}"
                                   TextWrapping="Wrap" Margin="2,0,2,4"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="2,0,2,10"/>

                        <TextBlock Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Sort}"
                                   Margin="2,0,2,4"/>
                        <ComboBox ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSort}" Margin="2,0,2,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <CheckBox IsChecked="{Binding SortDescending}" Margin="2,0"
                                  Content="{x:Static p:Resources.Lbl_Descending}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Robots of the selected repository (result of the LINQ query) -->
                <GroupBox Header="{x:Static p:Resources.Group_List}" Margin="0,12,0,0">
                    <ListBox MinHeight="120" HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding VisibleRobots}"
                             SelectedItem="{Binding SelectedRobot}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Mode=OneWay}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ProgressBar Value="{Binding Battery, Mode=OneWay}" Maximum="100" Height="8"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                    <ProgressBar Value="{Binding Integrity, Mode=OneWay}" Maximum="100" Height="8"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Opacity="0.5" Margin="0,5,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>

                <!-- Add robot -->
                <GroupBox Header="{x:Static p:Resources.Group_Add}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Type}"
                                   Margin="2,2,16,2" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="2,3"
                                  ItemsSource="{Binding Kinds}" SelectedItem="{Binding NewKind}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Id}"
                                   Margin="2,2,16,2" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="2,3"
                                 Text="{Binding NewId, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Name}"
                                   Margin="2,2,16,2" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="2,3"
                                 Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Battery}"
                                   Margin="2,2,16,2" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="2,3"
                                 Text="{Binding NewBattery, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="4" Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Integrity}"
                                   Margin="2,2,16,2" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="2,3"
                                 Text="{Binding NewIntegrity, UpdateSourceTrigger=PropertyChanged}"/>
                        <WrapPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,12,0,0">
                            <Button Style="{StaticResource LimeButton}" Content="{x:Static p:Resources.Btn_Add}"
                                    Command="{Binding AddCommand}" Padding="20,8" Margin="2,2,8,2"/>
                            <Button Content="{x:Static p:Resources.Btn_Remove}"
                                    Command="{Binding RemoveCommand}" Padding="20,8" Margin="2"/>
                        </WrapPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>

            <!-- ===================== RIGHT: details, actions, summary ===================== -->
            <StackPanel x:Name="RightPanel" Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">

                <!-- Details of the selected robot (lime card) -->
                <GroupBox Header="{x:Static p:Resources.Group_Details}"
                          Background="{StaticResource Lime}" Foreground="{StaticResource Ink}">
                    <Grid>
                        <!-- Shown only while no robot is selected -->
                        <TextBlock Text="{x:Static p:Resources.Msg_SelectRobot}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRobot}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Hidden while no robot is selected -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRobot}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding SelectedRobot.Name, Mode=OneWay}" FontSize="22"
                                       FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Cap}" Text="{Binding SelectedRobot.Kind, Mode=OneWay}"/>

                            <UniformGrid Columns="2" Margin="0,16,0,0">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock FontSize="34" FontWeight="SemiBold">
                                        <Run Text="{Binding SelectedRobot.Battery, Mode=OneWay}"/><Run Text="%" FontSize="20"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Battery}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ProgressBar Value="{Binding SelectedRobot.Battery, Mode=OneWay}" Maximum="100"
                                                 Foreground="{StaticResource Ink}" Background="#26000000"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock FontSize="34" FontWeight="SemiBold">
                                        <Run Text="{Binding SelectedRobot.Integrity, Mode=OneWay}"/><Run Text="%" FontSize="20"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Integrity}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ProgressBar Value="{Binding SelectedRobot.Integrity, Mode=OneWay}" Maximum="100"
                                                 Foreground="{StaticResource Ink}" Background="#26000000"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Actions: each button is a command, CanExecute dims it when it does not apply -->
                <GroupBox Header="{x:Static p:Resources.Group_Actions}" Margin="0,12,0,0">
                    <StackPanel>
                        <Button Content="{x:Static p:Resources.Btn_Work}" Command="{Binding WorkCommand}"
                                Padding="4,10" Margin="2"/>
                        <Button Style="{StaticResource LimeButton}" Content="{x:Static p:Resources.Btn_Crazy}"
                                Command="{Binding CrazyCommand}" Padding="4,10" Margin="2"/>

                        <TextBlock Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_ChargeAmount}"
                                   TextWrapping="Wrap" Margin="4,16,2,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static p:Resources.Btn_Charge}"
                                    Command="{Binding ChargeCommand}" Padding="20,8" Margin="8,2,2,2"/>
                            <TextBox Margin="2" FontSize="18"
                                     Text="{Binding ChargeAmount, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <Button Content="{x:Static p:Resources.Btn_Scan}" Command="{Binding ScanCommand}"
                                Margin="2,14,2,2" Padding="4,10"/>

                        <TextBlock Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_RepairTarget}"
                                   TextWrapping="Wrap" Margin="4,16,2,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static p:Resources.Btn_Repair}"
                                    Command="{Binding RepairCommand}" Padding="20,8" Margin="8,2,2,2"/>
                            <ComboBox Margin="2,3" ItemsSource="{Binding AllRobots}"
                                      SelectedItem="{Binding RepairTarget}"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <!-- LINQ: GroupBy summary over all repositories -->
                <GroupBox Header="{x:Static p:Resources.Group_Summary}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Type}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Cap}" HorizontalAlignment="Right"
                                       Text="{x:Static p:Resources.Col_Count}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Cap}" HorizontalAlignment="Right"
                                       TextWrapping="Wrap" Text="{x:Static p:Resources.Col_AvgBattery}"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource Cap}" HorizontalAlignment="Right"
                                       TextWrapping="Wrap" Text="{x:Static p:Resources.Col_AvgIntegrity}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Summary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="64"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{Binding Count}"/>
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right">
                                            <Run Text="{Binding AverageBattery, Mode=OneWay}"/><Run Text="%"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" HorizontalAlignment="Right">
                                            <Run Text="{Binding AverageIntegrity, Mode=OneWay}"/><Run Text="%"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- ===================== VOL.3: CPU calculations ===================== -->
            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,12">

                <!-- Choose objects and workload, start, cancel, watch progress -->
                <GroupBox Header="{x:Static p:Resources.Group_Compute}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_PickObjects}"/>
                        <ItemsControl ItemsSource="{Binding Calculation.Targets}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,0,20,10" IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding DataContext.Calculation.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Robot.Name}" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource Cap}" Text="{Binding Robot.Kind}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                            <Button Content="{x:Static p:Resources.Btn_SelectAll}" Command="{Binding Calculation.SelectAllCommand}"
                                    Padding="16,6" Margin="0,0,8,0"/>
                            <Button Content="{x:Static p:Resources.Btn_ClearSelection}" Command="{Binding Calculation.ClearSelectionCommand}"
                                    Padding="16,6"/>
                        </WrapPanel>

                        <TextBlock Style="{StaticResource Cap}" Text="{x:Static p:Resources.Lbl_Workload}" Margin="0,18,0,4"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Width="52" TextAlignment="Right" FontSize="22"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Text="{Binding Calculation.Workload}"/>
                            <Slider Minimum="{Binding Calculation.WorkloadMin}" Maximum="{Binding Calculation.WorkloadMax}"
                                    Value="{Binding Calculation.Workload}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    IsEnabled="{Binding Calculation.CanEdit}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="{x:Static p:Resources.Btn_RunSequential}" Command="{Binding Calculation.RunSequentialCommand}"
                                    Padding="20,10" Margin="0,0,8,8"/>
                            <Button Content="{x:Static p:Resources.Btn_RunParallel}" Command="{Binding Calculation.RunParallelCommand}"
                                    Padding="20,10" Margin="0,0,8,8"/>
                            <Button Style="{StaticResource LimeButton}" Content="{x:Static p:Resources.Btn_RunBoth}"
                                    Command="{Binding Calculation.RunBothCommand}" Padding="20,10" Margin="0,0,8,8"/>
                            <Button Content="{x:Static p:Resources.Btn_Cancel}" Command="{Binding Calculation.CancelCommand}"
                                    Padding="20,10" Margin="0,0,0,8"/>
                        </WrapPanel>

                        <ProgressBar Height="10" Margin="0,6,0,8" Minimum="0"
                                     Maximum="{Binding Calculation.ProgressMaximum}"
                                     Value="{Binding Calculation.ProgressValue, Mode=OneWay}"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Opacity="0.7"
                                       Text="{Binding Calculation.ElapsedText}"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Calculation.StatusText}"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Comparison of the two modes (lime card) -->
                <GroupBox Header="{x:Static p:Resources.Group_Compare}" Margin="0,12,0,0"
                          Background="{StaticResource Lime}" Foreground="{StaticResource Ink}">
                    <StackPanel>
                        <TextBlock Text="{Binding Calculation.SpeedupText}" FontSize="40" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Calculation.ComparisonText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Report of the sequential mode -->
                <GroupBox Header="{Binding Calculation.SequentialReport.Title}" Margin="0,12,0,0"
                          Visibility="{Binding Calculation.SequentialReport.HasRows, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Calculation.SequentialReport.Rows}"
                                      ItemTemplate="{StaticResource OutcomeRowTemplate}"/>
                        <TextBlock Style="{StaticResource Cap}" Text="{Binding Calculation.SequentialReport.CountsText}"
                                   TextWrapping="Wrap" Margin="2,4,0,0"/>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Calculation.SequentialReport.TotalText}" Margin="2,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Report of the parallel mode -->
                <GroupBox Header="{Binding Calculation.ParallelReport.Title}" Margin="0,12,0,0"
                          Visibility="{Binding Calculation.ParallelReport.HasRows, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Calculation.ParallelReport.Rows}"
                                      ItemTemplate="{StaticResource OutcomeRowTemplate}"/>
                        <TextBlock Style="{StaticResource Cap}" Text="{Binding Calculation.ParallelReport.CountsText}"
                                   TextWrapping="Wrap" Margin="2,4,0,0"/>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Calculation.ParallelReport.TotalText}" Margin="2,4,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- ===================== BOTTOM: log (actions + reactions) ===================== -->
            <GroupBox Grid.Row="4" Grid.ColumnSpan="2" Header="{x:Static p:Resources.Group_Log}">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Content="{x:Static p:Resources.Btn_ClearLog}" Command="{Binding ClearLogCommand}"
                            Padding="18,7"/>
                    <ListBox MinHeight="90" MaxHeight="220"
                             ItemContainerStyle="{StaticResource PlainItem}"
                             ItemsSource="{Binding Log}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</Window>